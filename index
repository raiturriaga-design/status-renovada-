function playerCard(p,st){return `<div class="card player"><div class="num">#${esc(p.jersey??'-')}</div>${p.photo?`<img class="playerphoto" src="${esc(p.photo)}">`:'<div class="playerphoto" style="display:grid;place-items:center;font-size:48px">👤</div>'}<h3>${esc(p.name)}</h3><div class="muted">${esc(teamName(p.teamId))} · ${esc(p.position||'Jugador')}</div><div class="statline"><span class="stat">🏀 ${st.pts}</span><span class="stat">↗ ${st.reb}</span><span class="stat">◎ ${st.ast}</span></div><button class="btn" style="margin-top:10px;width:100%" onclick="openPlayer('${p.id}')">Ver perfil</button></div>`}
function renderHome(){const st=stats();document.getElementById('homeKpis').innerHTML=[['🏀',db.teams.length,'Equipos'],['👥',db.players.length,'Jugadores'],['🏆',db.tournaments.length,'Torneos'],['📅',db.games.length,'Partidos']].map(x=>`<div class="card kpi"><b>${x[0]} ${x[1]}</b><small>${x[2]}</small></div>`).join('');const gs=db.games.filter(g=>g.status!=='FINALIZADO').slice(0,5);document.getElementById('homeGames').innerHTML=gs.length?gs.map(gameRow).join(''):'<div class="empty">No hay partidos próximos.</div>';const leaders=db.players.map(p=>({p,s:st[p.id]})).sort((a,b)=>b.s.pts-a.s.pts).slice(0,5);document.getElementById('homeLeaders').innerHTML=leaders.length?leaders.map(x=>`<div class="row"><div><b>${esc(x.p.name)}</b><div class="muted">${esc(teamName(x.p.teamId))}</div></div><span class="pill">${x.s.pts} PTS</span></div>`).join(''):'<div class="empty">Registra jugadores para ver líderes.</div>'}
function renderTeams(){document.getElementById('teamsList').innerHTML=db.teams.length?`<div class="grid3">${db.teams.map(t=>{const n=db.players.filter(p=>p.teamId===t.id).length;return `<div class="card"><div class="row" style="padding:0;border:0;background:transparent"><div class="left"><div class="teamlogo">${t.logo?`<img src="${esc(t.logo)}" style="width:100%;height:100%;object-fit:cover;border-radius:11px">`:'🏀'}</div><div><h3 style="margin:0">${esc(t.name)}</h3><div class="muted">${esc(t.category)} · ${esc(t.city)}</div></div></div><span class="pill">${n} jugadores</span></div><div class="actions" style="margin-top:15px"><button class="btn primary" onclick="openMatch(null,'${t.id}')">🏀 Partido</button><button class="btn" onclick="teamRoster('${t.id}')">👥 Plantilla</button></div></div>`}).join('')}</div>`:'<div class="empty">Aún no tienes equipos. Crea el primero.</div>'}
function renderPlayers(){const ids=[...new Set(db.players.map(p=>p.teamId))];document.getElementById('playerFilters').innerHTML=`<button class="btn ${teamFilter==='ALL'?'primary':''}" onclick="teamFilter='ALL';renderPlayers()">Todos</button>`+db.teams.map(t=>`<button class="btn ${teamFilter===t.id?'primary':''}" onclick="teamFilter='${t.id}';renderPlayers()">${esc(t.name)}</button>`).join('');const st=stats();let ps=db.players.filter(p=>teamFilter==='ALL'||p.teamId===teamFilter);document.getElementById('playersList').innerHTML=ps.length?`<div class="playergrid">${ps.map(p=>playerCard(p,st[p.id])).join('')}</div>`:'<div class="empty">No hay jugadores en este filtro.</div>'}
function gameRow(g){return `<div class="row"><div><b>${esc(g.homeName||teamName(g.home))}</b> <span class="muted">vs</span> <b>${esc(g.awayName||teamName(g.away))}</b><div class="muted">${esc(g.date||'Sin fecha')} ${esc(g.time||'')} · ${esc(g.place||'')}</div></div><div class="actions"><span class="pill">${esc(g.type)}</span><button class="btn primary" onclick="openGame('${g.id}')">${g.status==='FINALIZADO'?'Ver':'Abrir'}</button></div></div>`}
function renderGames(filter='all'){const gs=db.games.filter(g=>filter==='all'||g.type===filter).slice().sort((a,b)=>(a.date||'').localeCompare(b.date||''));document.getElementById('gamesList').innerHTML=gs.length?`<div class="list">${gs.map(gameRow).join('')}</div>`:'<div class="empty">No hay partidos registrados.</div>'}
function renderTournaments(){document.getElementById('tournamentsList').innerHTML=db.tournaments.length?`<div class="grid3">${db.tournaments.map(t=>`<div class="card"><div class="eyebrow">${esc(t.category||'COMPETICIÓN')}</div><h2>${esc(t.name)}</h2><div class="muted">${esc(t.city||'Chile')} · ${t.teamIds.length} equipos · ${esc(t.format)}</div><div class="actions" style="margin-top:14px"><button class="btn primary" onclick="openTournament('${t.id}')">Abrir torneo</button><button class="btn" onclick="generateCalendar('${t.id}')">📅 Calendario</button></div></div>`).join('')}</div>`:'<div class="empty">No hay torneos. Crea uno y selecciona sus equipos.</div>'}
function renderStats(){const st=stats(),rows=db.players.map(p=>({p,s:st[p.id]})).filter(x=>x.s.gp).sort((a,b)=>b.s.pts-a.s.pts);document.getElementById('statsContent').innerHTML=`<div class="grid"><div class="card kpi"><b>${db.games.filter(g=>g.status==='FINALIZADO').length}</b><small>PARTIDOS FINALIZADOS</small></div><div class="card kpi"><b>${rows.reduce((a,x)=>a+x.s.pts,0)}</b><small>PUNTOS REGISTRADOS</small></div><div class="card kpi"><b>${rows.reduce((a,x)=>a+x.s.reb,0)}</b><small>REBOTES</small></div><div class="card kpi"><b>${rows.reduce((a,x)=>a+x.s.ast,0)}</b><small>ASISTENCIAS</small></div></div><div class="card section"><h2>🏆 Líderes individuales</h2>${rows.length?`<div class="list">${rows.map((x,i)=>`<div class="row"><div><b>${i+1}. ${esc(x.p.name)}</b><div class="muted">${esc(teamName(x.p.teamId))} · ${x.s.gp} PJ</div></div><div class="pill">${statLine(x.s)}</div></div>`).join('')}</div>`:'<div class="empty">Las estadísticas aparecerán después de finalizar partidos.</div>'}</div>`}
function renderAll(){renderHome();renderTeams();renderPlayers();renderTournaments();renderGames();renderStats()}

/* ---------- equipos / jugadores ---------- */
function openTeam(){openModal('🏀 Nuevo equipo',`<div class="form"><div class="form2"><div class="field"><label>Nombre</label><input id="tName" placeholder="Ej. Larraín Basket"></div><div class="field"><label>Categoría</label><input id="tCat" placeholder="Adultos / U18 / Master +40"></div></div><div class="form2"><div class="field"><label>Ciudad</label><input id="tCity" value="Curicó"></div><div class="field"><label>Logo (URL opcional)</label><input id="tLogo" placeholder="https://..."></div></div><button class="btn primary" onclick="createTeam()">Crear equipo</button></div>`)}
function createTeam(){const n=document.getElementById('tName').value.trim();if(!n)return toast('Escribe el nombre del equipo');const t={id:uid(),name:n,category:document.getElementById('tCat').value.trim()||'Adultos',city:document.getElementById('tCity').value.trim()||'Chile',logo:document.getElementById('tLogo').value.trim()};db.teams.push(t);save();closeModal();toast('🏀 Equipo creado');go('teams')}
function openPlayer(id){if(id){const p=player(id);const s=stats()[id];openModal('👤 Perfil del jugador',`<div class="center">${p.photo?`<img class="playerphoto" style="max-width:260px" src="${esc(p.photo)}">`:'<div style="font-size:70px">👤</div>'}<h2>${esc(p.name)} · #${esc(p.jersey??'-')}</h2><p class="muted">${esc(teamName(p.teamId))} · ${esc(p.position||'Jugador')}</p><div class="grid3"><div class="card kpi"><b>${s.pts}</b><small>PTS</small></div><div class="card kpi"><b>${s.reb}</b><small>REB</small></div><div class="card kpi"><b>${s.ast}</b><small>AST</small></div></div></div>`);return}if(!db.teams.length)return toast('Primero crea un equipo');openModal('👤 Registrar jugador',`<div class="form"><div class="form2"><div class="field"><label>Nombre completo</label><input id="pName" placeholder="Nombre y apellido"></div><div class="field"><label>Número de camiseta</label><input id="pNum" type="number" min="0" max="99" placeholder="10"></div></div><div class="form2"><div class="field"><label>Equipo</label><select id="pTeam">${db.teams.map(t=>`<option value="${t.id}">${esc(t.name)}</option>`).join('')}</select></div><div class="field"><label>Posición</label><select id="pPos"><option>Base</option><option>Escolta</option><option>Alero</option><option>Ala-pívot</option><option>Pívot</option></select></div></div><div class="field"><label>Foto URL opcional</label><input id="pPhoto" placeholder="https://..."></div><button class="btn primary" onclick="createPlayer()">Guardar jugador</button></div>`)}
function createPlayer(){const n=document.getElementById('pName').value.trim();if(!n)return toast('Escribe el nombre');db.players.push({id:uid(),name:n,jersey:Number(document.getElementById('pNum').value)||0,teamId:document.getElementById('pTeam').value,position:document.getElementById('pPos').value,photo:document.getElementById('pPhoto').value.trim()});save();closeModal();toast('👤 Jugador registrado');go('players')}
function teamRoster(id){teamFilter=id;go('players')}

/* ---------- torneos ---------- */
function openTournament(id){if(id){const t=tour(id);const gs=db.games.filter(g=>g.tournamentId===id);openModal(`🏆 ${t.name}`,`<div class="card"><div class="eyebrow">${esc(t.category)}</div><h2>${esc(t.name)}</h2><p class="muted">${esc(t.city)} · ${t.teamIds.length} equipos · ${esc(t.format)}</p><div class="actions"><button class="btn primary" onclick="closeModal();openMatch('${id}')">➕ Partido de torneo</button><button class="btn" onclick="generateCalendar('${id}')">📅 Generar calendario</button></div></div><div class="section"><h3>Equipos</h3><div class="list">${t.teamIds.map(x=>`<div class="row"><b>${esc(teamName(x))}</b><span class="pill">${db.players.filter(p=>p.teamId===x).length} jugadores</span></div>`).join('')}</div></div><div class="section"><h3>Partidos</h3>${gs.length?`<div class="list">${gs.map(gameRow).join('')}</div>`:'<div class="empty">Aún no hay partidos.</div>'}</div>`);return}if(db.teams.length<2)return toast('Necesitas al menos 2 equipos');openModal('🏆 Crear torneo',`<div class="form"><div class="form2"><div class="field"><label>Nombre</label><input id="trName" placeholder="Liga Más 40 Curicó"></div><div class="field"><label>Categoría</label><input id="trCat" placeholder="Master +40"></div></div><div class="form2"><div class="field"><label>Formato</label><select id="trFormat"><option>Todos contra todos</option><option>Eliminación directa</option><option>Fase de grupos</option></select></div><div class="field"><label>Ciudad</label><input id="trCity" value="Curicó"></div></div><div class="field"><label>Selecciona los equipos</label><div class="checkgrid">${db.teams.map(t=>`<label class="check"><input type="checkbox" name="trTeam" value="${t.id}"> <span>${esc(t.name)}</span></label>`).join('')}</div></div><button class="btn primary" onclick="createTournament()">🏆 Crear torneo</button></div>`)}
function createTournament(){const ids=[...document.querySelectorAll('input[name=trTeam]:checked')].map(x=>x.value);if(ids.length<2)return toast('Selecciona al menos 2 equipos');const t={id:uid(),name:document.getElementById('trName').value.trim()||'Nuevo torneo',category:document.getElementById('trCat').value.trim()||'Básquetbol',format:document.getElementById('trFormat').value,city:document.getElementById('trCity').value.trim()||'Chile',teamIds:ids};db.tournaments.push(t);save();closeModal();toast('🏆 Torneo creado');go('tournaments')}
function generateCalendar(id){const t=tour(id);if(!t||t.teamIds.length<2)return;const exists=db.games.filter(g=>g.tournamentId===id).map(g=>[g.home,g.away].sort().join('|'));let count=0;for(let i=0;i<t.teamIds.length;i++)for(let j=i+1;j<t.teamIds.length;j++){const h=t.teamIds[i],a=t.teamIds[j],k=[h,a].sort().join('|');if(!exists.includes(k)){db.games.push({id:uid(),type:'TORNEO',tournamentId:id,home:h,away:a,homeName:teamName(h),awayName:teamName(a),date:'',time:'',place:'',status:'PROGRAMADO',score:{home:0,away:0},homePlayers:[],awayPlayers:[],stats:{},events:[]});count++}}save();toast(`📅 ${count} partidos agregados`);go('games')}

/* ---------- creación de partidos: única ruta ---------- */
function openMatch(tournamentId=null, preHome=null){roster={home:[],away:[]};const t=tournamentId?tour(tournamentId):null;openModal('🏀 Nuevo partido',`<div class="form"><div class="form2"><div class="field"><label>Tipo</label><select id="mType" onchange="refreshMatchForm()"><option value="AMISTOSO" ${!t?'selected':''}>Partido amistoso</option><option value="TORNEO" ${t?'selected':''}>Partido de torneo</option></select></div><div class="field"><label>Torneo</label><select id="mTournament" onchange="refreshMatchForm()"><option value="">Sin torneo</option>${db.tournaments.map(x=>`<option value="${x.id}" ${x.id===tournamentId?'selected':''}>${esc(x.name)}</option>`).join('')}</select></div></div><div class="form2"><div class="field"><label>Local</label><select id="mHome" onchange="loadConvocation('home')"><option value="">Seleccionar</option>${db.teams.map(x=>`<option value="${x.id}" ${x.id===preHome?'selected':''}>${esc(x.name)}</option>`).join('')}</select></div><div class="field"><label>Visita</label><select id="mAway" onchange="loadConvocation('away')"><option value="">Seleccionar</option>${db.teams.map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join('')}</select></div></div><div class="form2"><div class="field"><label>Fecha</label><input id="mDate" type="date"></div><div class="field"><label>Hora</label><input id="mTime" type="time"></div></div><div class="field"><label>Lugar</label><input id="mPlace" placeholder="Gimnasio municipal"></div><div id="convocation"></div><button class="btn primary" onclick="createGame()">🏀 Crear y abrir partido</button></div>`);setTimeout(()=>{if(preHome)loadConvocation('home')},0)}
function refreshMatchForm(){}
function loadConvocation(side){const sel=document.getElementById(side==='home'?'mHome':'mAway'),id=sel.value;roster[side]=[];const ps=db.players.filter(p=>p.teamId===id);const box=document.getElementById('convocation');const h=document.getElementById('mHome').value,a=document.getElementById('mAway').value;box.innerHTML=`<div class="section"><h3>Convocatoria</h3><div class="muted">Local: ${esc(teamName(h))} · Visita: ${esc(teamName(a))}</div><div class="checkgrid" style="margin-top:8px">${h?db.players.filter(p=>p.teamId===h).map(p=>`<label class="check"><input type="checkbox" data-side="home" value="${p.id}" onchange="pick(this)"> #${esc(p.jersey)} ${esc(p.name)}</label>`).join(''):''}${a?db.players.filter(p=>p.teamId===a).map(p=>`<label class="check"><input type="checkbox" data-side="away" value="${p.id}" onchange="pick(this)"> #${esc(p.jersey)} ${esc(p.name)}</label>`).join(''):''}</div></div>`}
function pick(x){const a=roster[x.dataset.side];if(x.checked){if(!a.includes(x.value))a.push(x.value)}else{const i=a.indexOf(x.value);if(i>=0)a.splice(i,1)}}
function createGame(){const h=document.getElementById('mHome').value,a=document.getElementById('mAway').value;if(!h||!a||h===a)return toast('Selecciona dos equipos diferentes');if(!roster.home.length||!roster.away.length)return toast('Convoca al menos un jugador por equipo');const type=document.getElementById('mType').value,tid=document.getElementById('mTournament').value||null;if(type==='TORNEO'&&!tid)return toast('Selecciona el torneo');const st={};[...roster.home,...roster.away].forEach(id=>st[id]={pts:0,reb:0,ast:0,stl:0,blk:0,tov:0,pf:0});const g={id:uid(),type,tournamentId:tid,home:h,away:a,homeName:teamName(h),awayName:teamName(a),date:document.getElementById('mDate').value,time:document.getElementById('mTime').value,place:document.getElementById('mPlace').value.trim(),status:'EN VIVO',quarter:1,clock:600,homeScore:0,awayScore:0,homePlayers:[...roster.home],awayPlayers:[...roster.away],stats:st,events:[]};db.games.push(g);save();closeModal();openGame(g.id);toast('🏀 Partido creado correctamente')}
function openGame(id){const g=db.games.find(x=>x.id===id);if(!g)return;liveId=id;go('live');renderLive()}
function currentGame(){return db.games.find(g=>g.id===liveId)}
function renderLive(){const g=currentGame();if(!g){go('games');return}document.getElementById('liveContent').innerHTML=`<div class="hero"><div><div class="eyebrow">MESA ESTADÍSTICA · ${esc(g.type)}</div><h1>${esc(g.homeName)} vs ${esc(g.awayName)}</h1><div class="muted">${esc(g.date||'')} ${esc(g.time||'')} · ${esc(g.place||'')}</div></div><div class="actions"><button class="btn" onclick="go('games')">← Partidos</button><button class="btn danger" onclick="finishGame()">Finalizar partido</button></div></div><div class="livebar"><div class="scoreboard"><div class="center"><b>${esc(g.homeName)}</b><div class="bigscore">${g.homeScore}</div></div><div><div class="clock" id="clock">${fmt(g.clock)}</div><div class="center">CUARTO ${g.quarter}</div><div class="actions" style="justify-content:center;margin-top:8px"><button class="btn cyan" onclick="toggleClock()">${clockTimer?'⏸ Pausar':'▶ Iniciar'}</button><button class="btn" onclick="nextQuarter()">Siguiente cuarto</button></div></div><div class="center"><b>${esc(g.awayName)}</b><div class="bigscore">${g.awayScore}</div></div></div></div><div class="playerslive"><div class="card"><h2>${esc(g.homeName)}</h2>${livePlayers(g,'home')}</div><div class="card"><h2>${esc(g.awayName)}</h2>${livePlayers(g,'away')}</div></div><div class="card section"><h2>📝 Eventos</h2><div class="events">${(g.events||[]).slice().reverse().map(e=>`<div class="event">${esc(e.text)}</div>`).join('')||'Sin eventos todavía.'}</div></div>`}
function livePlayers(g,side){return (g[side+'Players']||[]).map(id=>{const p=player(id),s=g.stats[player(id)?.id ?? id]||{};return `<div class="liveplayer"><span class="pill">#${esc(p?.jersey??'-')}</span><div><b>${esc(p?.name||'Jugador')}</b><div class="muted">${statLine(s)}</div></div><div class="actions"><button class="btn" onclick="act('${id}','pts',1)">+2</button><button class="btn" onclick="act('${id}','pts',3)">+3</button><button class="btn" onclick="act('${id}','reb',1)">REB</button><button class="btn" onclick="act('${id}','ast',1)">AST</button></div></div>`}).join('')||'<div class="empty">Sin convocados.</div>'}
function act(pid,key,val){const g=currentGame();if(!g)return;g.stats[pid][key]=(g.stats[pid][key]||0)+val;if(key==='pts'){if(g.homePlayers.includes(pid))g.homeScore+=val;else g.awayScore+=val}g.events.push({text:`#${player(pid)?.jersey||'-'} ${player(pid)?.name||''}: ${key.toUpperCase()} +${val} · ${g.homeScore}-${g.awayScore}`});save();renderLive()}
function fmt(s){s=Math.max(0,Number(s)||0);return `${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`}
function toggleClock(){if(clockTimer){clearInterval(clockTimer);clockTimer=null;return renderLive()}clockTimer=setInterval(()=>{const g=currentGame();if(!g){clearInterval(clockTimer);clockTimer=null;return}g.clock--;if(g.clock<=0){clearInterval(clockTimer);clockTimer=null;g.clock=0}localStorage.setItem(V30_KEY,JSON.stringify(db));const x=document.getElementById('clock');if(x)x.textContent=fmt(g.clock)},1000);renderLive()}
function nextQuarter(){const g=currentGame();if(!g)return;g.quarter++;g.clock=600;save();renderLive()}
function finishGame(){const g=currentGame();if(!g)return;if(clockTimer){clearInterval(clockTimer);clockTimer=null}g.status='FINALIZADO';g.finishedAt=new Date().toISOString();save();toast('✅ Partido finalizado y estadísticas guardadas');go('games')}
function openAccount(){openModal('👤 Mi cuenta',`<div class="form"><div class="field"><label>Nombre</label><input id="accName" value="${esc(db.profile.name)}"></div><div class="field"><label>Email</label><input id="accEmail" value="${esc(db.profile.email)}"></div><div class="field"><label>Foto URL</label><input id="accPhoto" value="${esc(db.profile.photo)}"></div><button class="btn primary" onclick="saveAccount()">Guardar perfil</button></div>`)}
function saveAccount(){db.profile={name:document.getElementById('accName').value.trim(),email:document.getElementById('accEmail').value.trim(),photo:document.getElementById('accPhoto').value.trim()};save();closeModal();toast('👤 Perfil actualizado');updateAccount()}
function updateAccount(){document.getElementById('accountName').textContent=db.profile.name||'Modo local';const a=document.getElementById('accountAvatar');a.innerHTML=db.profile.photo?`<img src="${esc(db.profile.photo)}" style="width:100%;height:100%;object-fit:cover;border-radius:50%">`:initials(db.profile.name)}
/* ---------- integración Supabase: opcional y aislada ---------- */
function backupLegacy(){const raw=localStorage.getItem(KEY); if(raw) localStorage.setItem('statshub_chile_v11_backup_before_v30',raw)}
async function cloudSignIn(){if(!sb)return toast('Supabase no disponible');const email=prompt('Email');if(!email)return;const {error}=await sb.auth.signInWithOtp({email});toast(error?'❌ '+error.message:'📩 Revisa tu correo para iniciar sesión')}
async function cloudSession(){if(!sb)return;const {data}=await sb.auth.getSession();const u=data?.session?.user;if(u){db.profile.email=u.email||'';if(!db.profile.name)db.profile.name=u.email.split('@')[0];save();updateAccount()}}
document.addEventListener('DOMContentLoaded',()=>{backupLegacy();updateAccount();renderAll();cloudSession();go('home');toast('V30 PRO cargada · datos anteriores conservados')});
</script>
</body>
